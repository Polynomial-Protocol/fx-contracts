{
  "name": "@synthetixio/common-config",
  "version": "3.8.1",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "contracts",
    "!contracts/generated",
    "hardhat.config.ts"
  ],
  "description": "Common configuration used by all Hardhat packages",
  "scripts": {
    "build": "yarn build:ts",
    "build:ts": "echo 'Needed because https://github.com/yarnpkg/berry/issues/3995'"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.8",
    "@synthetixio/hardhat-storage": "workspace:*",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/hardhat": "^9.1.0",
    "dotenv": "^17.4.2",
    "hardhat": "^3.4.2",
    "hardhat-cannon": "2.18.2",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^2.3.0",
    "hardhat-ignore-warnings": "^0.3.0",
    "solidity-coverage": "^0.8.7",
    "typechain": "^8.3.2"
  },
  "depcheck": {
    "ignoreMatches": [
      "@typechain/ethers-v5"
    ]
  }
}
